# ===========================================
# FuelFlow environment variables
# Copy this file to .env and adjust values.
# ===========================================

# Node environment
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=fuelflow
POSTGRES_PASSWORD=fuelflow
POSTGRES_DB=fuelflow
# The port Docker publishes on the host. Postgres itself still listens on 5432 inside the
# container, and the backend and worker reach it as `postgres:5432` over the compose
# network, so this only affects connections made from Windows. Defaults to 5433 because a
# native PostgreSQL 17 Windows service holds 0.0.0.0:5432 from boot on some machines, and
# a host connection to 127.0.0.1:5432 then reaches that server instead of the container —
# which reports the container's credentials as invalid. Keep in step with DATABASE_URL.
POSTGRES_PORT=5433
# 127.0.0.1 rather than localhost, deliberately: on Windows `localhost` resolves to ::1
# first, which is not always Docker's published port, and the test suite then fails in
# beforeAll with "Can't reach database server" depending on which listener wins. The
# containers build their own DATABASE_URL from the components above.
DATABASE_URL=postgresql://fuelflow:fuelflow@127.0.0.1:5433/fuelflow

# Redis
# For running the backend directly on the host. Inside Docker Compose the containers build
# their own address from REDIS_HOST/REDIS_PORT below, because `localhost` in a container is
# that container — so changing this value does NOT redirect the containers.
REDIS_URL=redis://127.0.0.1:6379

# Which Redis the containers talk to, by compose service name. Only used inside Docker.
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000

# Where uploaded shift-report PDFs are stored, relative to apps/backend, when the backend
# runs outside Docker. Inside Docker Compose both the backend and the worker use the shared
# pdf-storage volume at /app/storage/pdfs instead, so this value does not apply there.
STORAGE_DIR=./storage/pdfs

# How many shift reports the worker parses at once. Each parse is mostly CPU-bound.
PARSE_CONCURRENCY=2

# JWT (generate a strong secret for production)
JWT_SECRET=super-secret-change-me

# Frontend
VITE_API_BASE_URL=/api

# Caddy routing (used inside Docker Compose)
CADDY_BACKEND_HOST=backend:3000
CADDY_FRONTEND_HOST=frontend:80
